{
    "name": "@your-job-search-genius/ui-tree",
    "version": "0.2.0",
    "description": "UI tree schema, patch ops, renderer, and codegen shared by the docs playground and ds-mcp -- the model never writes raw JSX, only this JSON tree, which is validated, rendered, and turned into TSX by this package.",
    "private": false,
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "exports": {
        ".": "./lib/index.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@your-job-search-genius/ds-registry": "workspace:*",
        "prettier": "^3.9.6",
        "react": "^19.2.8",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.0",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.4",
        "@your-job-search-genius/ds-mcp": "workspace:*",
        "jsdom": "^27.0.0",
        "react-dom": "^19.2.8",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "restricted",
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Your-Job-Search-Genius/odyssey-ui.git",
        "directory": "packages/ui-tree"
    },
    "files": [
        "lib",
        "README.md"
    ]
}