{
    "name": "@your-job-search-genius/odyssey-ui",
    "version": "1.0.2",
    "description": "Writesea Odyssey design system \u2014 React component library from the Writesea Odyssey Figma system, WCAG 2.2 AA",
    "private": false,
    "publishConfig": {
        "access": "restricted",
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "storybook": "storybook dev -p 6006 --no-open",
        "build-storybook": "storybook build -o ./storybook-static",
        "lint": "eslint components --fix",
        "lint:check": "eslint components",
        "type-check": "tsc --noEmit"
    },
    "keywords": [
        "react",
        "components",
        "tailwind",
        "ui",
        "design-system",
        "typescript"
    ],
    "author": "YJSG",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Your-Job-Search-Genius/odyssey-ui/issues"
    },
    "homepage": "https://github.com/Your-Job-Search-Genius/odyssey-ui#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/Your-Job-Search-Genius/odyssey-ui.git",
        "directory": "packages/ui"
    },
    "files": [
        "components",
        "hooks",
        "utils",
        "styles",
        "!components/**/*.story.tsx",
        "!components/internal"
    ],
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.3",
        "@tailwindcss/typography": "^0.5.20",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@react-types/overlays": "^3.10.0",
        "@react-types/shared": "^3.36.1",
        "embla-carousel-react": "^8.6.0",
        "input-otp": "^1.4.2",
        "motion": "^12.42.2",
        "qr-code-styling": "^1.9.2",
        "react-aria": "^3.51.0",
        "react-aria-components": "^1.20.0",
        "react-hook-form": "^7.82.0",
        "react-stately": "^3.50.0",
        "recharts": "^3.10.0",
        "tailwind-merge": "^3.6.0",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0"
    }
