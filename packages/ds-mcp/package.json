{
    "name": "@your-job-search-genius/ds-mcp",
    "version": "0.1.0",
    "description": "MCP server exposing the Writesea Odyssey component library (components, tokens, icons, rules) plus a validate_jsx tool, so agents in Claude Code / Cursor build UI only from approved components.",
    "private": false,
    "type": "module",
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "bin": {
        "ds-mcp": "./lib/cli/bin.js"
    },
    "exports": {
        ".": "./lib/index.js",
        "./validator": "./lib/validator.js",
        "./http": "./lib/http.js"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "type-check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "start:stdio": "node lib/cli/bin.js"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.30.0",
        "@your-job-search-genius/ds-registry": "workspace:*",
        "typescript": "^5.9.3",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.1.1",
        "tsx": "^4.20.0",
        "vitest": "^3.2.4"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "restricted",
        "registry": "https://npm.pkg.github.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/Your-Job-Search-Genius/odyssey-ui.git",
        "directory": "packages/ds-mcp"
    },
    "files": [
        "lib",
        "README.md"
    ]
}