{
    "name": "yjsg-ui-workspace",
    "version": "0.0.0",
    "description": "Workspace root for the Writesea Odyssey design system: the component library (packages/ui), the AI design-system tooling (packages/registry, packages/ds-mcp, packages/ui-tree), and the Fumadocs site (apps/docs).",
    "private": true,
    "packageManager": "pnpm@11.24.0",
    "scripts": {
        "storybook": "pnpm --filter @your-job-search-genius/odyssey-ui run storybook",
        "build-storybook": "pnpm --filter @your-job-search-genius/odyssey-ui run build-storybook",
        "lint": "pnpm -r --if-present run lint",
        "lint:check": "pnpm -r --if-present run lint:check",
        "prettier": "prettier . --write",
        "prettier:check": "prettier . --check",
        "type-check": "pnpm -r --if-present run type-check",
        "test": "pnpm run type-check && pnpm run lint:check && pnpm run prettier:check && pnpm run test:unit",
        "docs:sync": "pnpm --filter @your-job-search-genius/docs run sync",
        "docs:new-doc": "pnpm --filter @your-job-search-genius/docs run new-doc",
        "docs:dev": "pnpm --filter @your-job-search-genius/ds-registry run build && pnpm --filter @your-job-search-genius/docs run dev",
        "docs:build": "pnpm --filter @your-job-search-genius/ds-registry run build && pnpm --filter @your-job-search-genius/docs run build",
        "docs:build:static": "pnpm --filter @your-job-search-genius/ds-registry run build && pnpm --filter @your-job-search-genius/docs run build:static",
        "docs:start": "pnpm --filter @your-job-search-genius/docs run start",
        "registry:build": "pnpm --filter @your-job-search-genius/ds-registry run registry:build",
        "registry:check-drift": "pnpm run registry:build && test -z \"$(git status --porcelain -- packages/registry/dist)\"",
        "test:unit": "pnpm -r --if-present run test",
        "evals": "pnpm --filter @your-job-search-genius/docs run evals"
    },
    "author": "YJSG",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Your-Job-Search-Genius/yjsg-ui.git"
    },
    "dependencies": {
        "@internationalized/date": "^3.12.3",
        "@react-aria/utils": "^3.34.1",
        "@react-stately/utils": "^3.12.1",
        "@react-types/overlays": "^3.10.0",
        "@react-types/shared": "^3.36.1",
        "@tailwindcss/typography": "^0.5.20",
        "embla-carousel-react": "^8.6.0",
        "fumadocs-core": "^16.15.8",
        "fumadocs-mdx": "^15.4.0",
        "fumadocs-ui": "^16.15.8",
        "input-otp": "^1.4.2",
        "motion": "^12.42.2",
        "next": "^16.3.0",
        "next-themes": "^0.4.6",
        "qr-code-styling": "^1.9.2",
        "react": "^19.2.8",
        "react-aria": "^3.51.0",
        "react-aria-components": "^1.20.0",
        "react-dom": "^19.2.8",
        "react-hook-form": "^7.82.0",
        "react-stately": "^3.50.0",
        "recharts": "^3.10.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.3.3",
        "tailwindcss-animate": "^1.0.7",
        "tailwindcss-react-aria-components": "^2.2.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@chromatic-com/storybook": "^5.2.1",
        "@eslint/eslintrc": "^3.3.6",
        "@next/eslint-plugin-next": "16.3.4",
        "@storybook/addon-themes": "^10.5.3",
        "@storybook/nextjs-vite": "10.5.3",
        "@tailwindcss/postcss": "^4.3.3",
        "@tailwindcss/vite": "^4.3.3",
        "@trivago/prettier-plugin-sort-imports": "^6.0.2",
        "@types/mdx": "^2.0.13",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "@typescript-eslint/parser": "^8.65.0",
        "@vitejs/plugin-react": "^6.0.4",
        "eslint": "^10.7.0",
        "eslint-config-next": "^16.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-storybook": "10.5.3",
        "eslint-plugin-tailwindcss": "^4.2.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "postcss": "^8.5.21",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "react-docgen-typescript": "^2.4.0",
        "storybook": "^10.5.3",
        "tsx": "^4.20.0",
        "typescript": "^5.9.3",
        "vite": "^8.1.5"
    }
}