*~

# Temporary files
*.tmp
*.temp

# Docs (Fumadocs site) build artifacts -- regenerated by
# `pnpm run docs:sync` / `next dev` / `next build`, never hand-edited.
apps/docs/.generated/
apps/docs/.source/
apps/docs/lib/demo-registry.ts
apps/docs/lib/playground-registry.ts
apps/docs/lib/playground/component-map.generated.ts

# Eval run output -- regenerated by `pnpm run evals` (apps/docs/evals/cli.ts),
# timestamped per run, never hand-edited.
apps/docs/evals/results/
apps/docs/next-env.d.ts
apps/docs/CLAUDE.md
apps/docs/AGENTS.md

# Registry (packages/registry) compiled output -- regenerated by
# `pnpm run build`. NOTE: packages/registry/dist/ (the generated
# registry.json/tokens.json/icons.json data, as opposed to this compiled
# JS) is deliberately NOT ignored -- it is committed so CI can diff a
# fresh rebuild against it (see packages/registry/README.md's drift
# protection section).
packages/registry/lib/
packages/ds-mcp/lib/
packages/ui-tree/lib/
packages/eslint-plugin-ds/lib/