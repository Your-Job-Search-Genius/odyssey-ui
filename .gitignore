# Dependencies
node_modules/
.pnp
.pnp.js

# Production builds
build/
dist/
.next/
# Static-export build output (deploy-docs.yml / DOCS_STATIC_EXPORT=1)
apps/docs/out/
storybook-static/
tsconfig.tsbuildinfo

# Development
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
