# Scope → GitHub Packages. Do NOT put `_authToken=${…}` here — pnpm ignores
# env expansion in project .npmrc credentials (GHSA-3qhv-2rgh-x77r). Put the
# token in ~/.npmrc, or run: pnpm config set "//npm.pkg.github.com/:_authToken" <token>
@your-job-search-genius:registry=https://npm.pkg.github.com
